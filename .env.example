# Copy to .env and fill in. docker compose reads it automatically.

# Free key from https://finnhub.io/register (company figures and news).
FINNHUB_API_KEY=

# Password for the Postgres cache. Any long random string.
# Letters and digits only: it goes inside a database URL.
POSTGRES_PASSWORD=changeme123

# Public domain name for HTTPS, for example example.dev. Its DNS A record must
# point at this server's public IP.
DOMAIN=

# Free name and token from https://www.duckdns.org, for the HTTPS certificate.
# Add a CNAME record for _acme-challenge on DOMAIN pointing at DUCKDNS_DOMAIN.
# Full name, for example example.duckdns.org.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
