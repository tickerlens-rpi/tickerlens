# Copy to .env and fill in. docker compose reads it automatically.

# Free key from https://finnhub.io/register (company figures and news).
FINNHUB_API_KEY=

# Password for the Postgres cache. Any long random string.
# Letters and digits only: it goes inside a database URL.
POSTGRES_PASSWORD=changeme123

# Port the site is served on (http://localhost by default).
FRONTEND_PORT=80
